rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner';
    }

    function isReporter() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'reporter'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.reporterStatus == 'approved'
        );
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner());

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'user'
        && request.resource.data.reporterStatus == 'pending';

      allow update: if isOwner()
        || (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.reporterStatus == resource.data.reporterStatus
        );

      allow delete: if isOwner();
    }

    match /news/{newsId} {
      allow read: if true;
      allow create, update, delete: if isOwner();

      match /likes/{likeId} {
        allow read: if true;
        allow create: if signedIn() && (
          likeId == request.auth.uid ||
          request.resource.data.uid == request.auth.uid ||
          request.resource.data.userId == request.auth.uid
        );
        allow delete: if signedIn() && (
          likeId == request.auth.uid ||
          resource.data.uid == request.auth.uid ||
          resource.data.userId == request.auth.uid
        );
        allow update: if signedIn() && (
          likeId == request.auth.uid ||
          resource.data.uid == request.auth.uid ||
          resource.data.userId == request.auth.uid
        );
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn() && (
          request.resource.data.uid == request.auth.uid ||
          request.resource.data.userId == request.auth.uid
        );
        allow update, delete: if isOwner()
          || (signedIn() && (
            resource.data.uid == request.auth.uid ||
            resource.data.userId == request.auth.uid
          ));
      }
    }

    match /reporterPosts/{postId} {
      allow read: if isOwner()
        || (signedIn() && resource.data.reporterId == request.auth.uid);

      allow create: if isReporter()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'pending';

      allow update: if isOwner();

      allow delete: if isOwner()
        || (signedIn()
          && resource.data.reporterId == request.auth.uid
          && resource.data.status == 'pending');
    }

    match /likes/{likeId} {
      allow read: if true;
      allow create: if signedIn() && (
        request.resource.data.uid == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
      allow update: if signedIn() && (
        resource.data.uid == request.auth.uid ||
        resource.data.userId == request.auth.uid
      );
      allow delete: if signedIn() && (
        resource.data.uid == request.auth.uid ||
        resource.data.userId == request.auth.uid
      );
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if signedIn() && (
        request.resource.data.uid == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
      allow update: if isOwner() || (signedIn() && (
        resource.data.uid == request.auth.uid ||
        resource.data.userId == request.auth.uid
      ));
      allow delete: if isOwner() || (signedIn() && (
        resource.data.uid == request.auth.uid ||
        resource.data.userId == request.auth.uid
      ));
    }
  }
}
