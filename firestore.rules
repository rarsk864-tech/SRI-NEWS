rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // AUTH
    // ============================================================

    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && request.auth.uid == 'awKV4C8EnfN2B15hCYAcTkGy7nl1';
    }

    // ADMIN: role is stored in /users/{uid}.role
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'administrator'
        );
    }

    // REPORTER: accept the role, roleLabel, or approved application status.
    function isReporter() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'reporter'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roleLabel == 'REPORTER'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.reporterStatus == 'approved'
        );
    }

    function isOwnerOrAdmin() {
      return isOwner() || isAdmin();
    }

    // ============================================================
    // NEWS
    // ============================================================

    match /news/{newsId} {

      // Everyone can read published news.
      allow read: if true;

      // Owner/Admin can create/delete news.
      // AdminPage publishes news directly to /news.
      allow create, delete: if isOwnerOrAdmin();

      // Owner/Admin can update anything.
      //
      // Normal logged-in users can update only:
      // likes / likeCount
      //
      // This keeps normal users from changing title,
      // matter, image, category, etc.
      allow update: if isOwnerOrAdmin()
        || (
          signedIn()
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'likes',
                'likeCount'
              ])
        );


      // ==========================================================
      // LIKES
      // Path:
      // news/{newsId}/likes/{userId}
      // ==========================================================

      match /likes/{userId} {

        // Everyone can read like documents.
        allow read: if true;

        // User can create only his/her own like.
        allow create: if signedIn()
          && userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid;

        // User can remove only his/her own like.
        allow delete: if signedIn()
          && userId == request.auth.uid
          && resource.data.userId == request.auth.uid;

        // Likes should not be edited.
        allow update: if false;
      }


      // ==========================================================
      // COMMENTS
      // Path:
      // news/{newsId}/comments/{commentId}
      // ==========================================================

      match /comments/{commentId} {

        // Everyone can read comments.
        allow read: if true;

        // Logged-in user can create only his/her own comment.
        allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid;

        // Owner can edit/delete any comment.
        allow update, delete: if isOwner();

        // Normal user can edit/delete only own comment.
        allow update, delete: if signedIn()
          && resource.data.userId == request.auth.uid;
      }
    }


    // ============================================================
    // USERS
    // ============================================================

    match /users/{userId} {

      // Owner can read all users.
      // Normal user can read own profile.
      allow read: if isOwner()
        || (
          signedIn()
          && userId == request.auth.uid
        );

      // User creates own profile as a normal USER.
      // Reporter/Admin application can be submitted later.
      allow create: if signedIn()
        && userId == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'user';

      // Owner can update anything.
      allow update: if isOwner();

      // Normal USER can submit/update only their own pending
      // Reporter/Admin application. They cannot change their role.
      allow update: if signedIn()
        && userId == request.auth.uid
        && resource.data.role == 'user'
        && request.resource.data.role == 'user'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'uid',
              'name',
              'email',
              'photoUrl',
              'displayName',
              'role',
              'roleLabel',
              'reporterStatus',
              'reporterAppliedAt',
              'adminStatus',
              'adminAppliedAt',
              'updatedAt'
            ])
        && (
          !request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasAny(['reporterStatus'])
          || request.resource.data.reporterStatus == 'pending'
        )
        && (
          !request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasAny(['adminStatus'])
          || request.resource.data.adminStatus == 'pending'
        );

      // Only Owner can delete users.
      allow delete: if isOwner();
    }


    // ============================================================
    // REPORTER POSTS
    // ============================================================

    match /reporterPosts/{postId} {

      // Owner/Admin can read all reporter posts.
      // Reporter can read own posts.
      allow read: if isOwnerOrAdmin()
        || (
          signedIn()
          && resource.data.reporterId == request.auth.uid
        );

      // Approved reporter can submit pending post.
      allow create: if isReporter()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'pending';

      // Owner/Admin can approve/reject/edit/delete.
      allow update, delete: if isOwnerOrAdmin();

      // Reporter can edit/delete own post while pending.
      allow update, delete: if signedIn()
        && resource.data.reporterId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'pending';
    }


    // ============================================================
    // DEFAULT DENY
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
