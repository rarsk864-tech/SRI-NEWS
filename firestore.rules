rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return signedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid))
        : null;
    }

    function role() {
      return signedIn()
        ? userDoc().data.role
        : '';
    }

    function isOwner() {
      return signedIn() && role() == 'owner';
    }

    function isAdmin() {
      return signedIn() && (role() == 'admin' || role() == 'administrator');
    }

    function isReporter() {
      return signedIn() && (role() == 'reporter' || userDoc().data.reporterStatus == 'approved');
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner() || isAdmin());

      // New accounts are always created as normal users. Reporter applications
      // are then submitted by the signed-in account itself.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'user';

      // Owner can manage roles/reporter status. A normal account can only
      // update its own profile/application fields and cannot elevate its role.
      allow update: if isOwner()
        || (signedIn()
            && request.auth.uid == uid
            && request.resource.data.role == resource.data.role);

      allow delete: if isOwner();
    }

    match /reporterPosts/{postId} {
      // Owner/Admin review all reporter posts; Reporter can see only own posts.
      allow read: if isOwner() || isAdmin()
        || (isReporter() && resource.data.reporterId == request.auth.uid);

      allow create: if isReporter()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'pending';

      // Only Owner/Admin can change approval status or publish a reporter post.
      allow update: if isOwner() || isAdmin();
      allow delete: if isOwner() || isAdmin();
    }

    match /news/{newsId} {
      // Published news is public.
      allow read: if true;
      allow create, update, delete: if isOwner() || isAdmin();
    }

    match /likes/{likeId} {
      allow read, write: if signedIn();
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
