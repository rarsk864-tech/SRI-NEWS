rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner() { return signedIn() && request.auth.token.admin == true; }
    function approvedReporter() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.reporterStatus == 'approved';
    }

    match /news/{newsId} {
      allow read: if true;
      allow create, update, delete: if owner();
      match /likes/{userId} {
        allow read: if true;
        allow create, delete: if signedIn() && request.auth.uid == userId;
      }
      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn() && request.resource.data.userId == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
      }
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || owner());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'user'
        && request.resource.data.reporterStatus == 'pending';
      allow update: if owner() || (signedIn() && request.auth.uid == uid
        && request.resource.data.reporterStatus == resource.data.reporterStatus
        && request.resource.data.role == resource.data.role);
    }

    match /reporterApplications/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow read: if owner() || (signedIn() && request.auth.uid == uid);
      allow delete: if owner();
    }

    match /reporterPosts/{postId} {
      allow read: if true;
      allow create: if approvedReporter()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if owner() || (approvedReporter() && resource.data.reporterId == request.auth.uid && request.resource.data.status == resource.data.status);
      allow delete: if owner() || (approvedReporter() && resource.data.reporterId == request.auth.uid);
    }
  }
}
