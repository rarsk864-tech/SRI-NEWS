rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // AUTH
    // ============================================================

    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && request.auth.uid == 'awKV4C8EnfN2B15hCYAcTkGy7nl1';
    }

    // ADMIN: role is stored in /users/{uid}.role
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwnerOrAdmin() {
      return isOwner() || isAdmin();
    }

    // ============================================================
    // NEWS
    // ============================================================

    match /news/{newsId} {

      allow read: if true;

      allow create, delete: if isOwnerOrAdmin();

      allow update: if isOwnerOrAdmin()
        || (
          signedIn()
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'likes',
                'likeCount'
              ])
        );

      match /likes/{userId} {
        allow read: if true;

        allow create: if signedIn()
          && userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid;

        allow delete: if signedIn()
          && userId == request.auth.uid
          && resource.data.userId == request.auth.uid;

        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if true;

        allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid;

        allow update, delete: if isOwner();

        allow update, delete: if signedIn()
          && resource.data.userId == request.auth.uid;
      }
    }

    // ============================================================
    // USERS
    // ============================================================

    match /users/{userId} {

      // Owner can read all users.
      // Logged-in user can read ONLY own profile.
      allow read: if isOwner()
        || (
          signedIn()
          && userId == request.auth.uid
        );

      // User creates own profile.
      allow create: if signedIn()
        && userId == request.auth.uid;

      // Owner can update anything.
      allow update: if isOwner();

      // Normal user can update safe profile/application fields only.
      allow update: if signedIn()
        && userId == request.auth.uid
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'name',
              'photoUrl',
              'displayName',
              'reporterStatus',
              'reporterAppliedAt',
              'adminStatus',
              'adminAppliedAt'
            ])
        && (
          !request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasAny(['reporterStatus'])
          || request.resource.data.reporterStatus == 'pending'
        )
        && (
          !request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasAny(['adminStatus'])
          || request.resource.data.adminStatus == 'pending'
        );

      // Only Owner can delete users.
      allow delete: if isOwner();
    }

    // ============================================================
    // REPORTER POSTS
    // ============================================================

    match /reporterPosts/{postId} {

      // Owner/Admin can read all reporter posts.
      // Reporter can read own posts.
      allow read: if isOwnerOrAdmin()
        || (
          signedIn()
          && resource.data.reporterId == request.auth.uid
        );

      // Approved reporter can submit pending post.
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'pending';

      // Owner/Admin can approve/reject/edit/delete.
      allow update, delete: if isOwnerOrAdmin();

      // Reporter can edit/delete own post while pending.
      allow update, delete: if signedIn()
        && resource.data.reporterId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'pending';
    }

    // ============================================================
    // DEFAULT DENY
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
