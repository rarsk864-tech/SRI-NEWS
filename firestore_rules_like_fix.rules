rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && request.auth.uid == 'awKV4C8EnfN2B15hCYAcTkGy7nl1';
    }

    // NEWS
    match /news/{newsId} {
      allow read: if true;

      allow create, delete: if isOwner();

      // Owner can update anything.
      // Users can update only like-related fields.
      allow update: if isOwner()
        || (
          signedIn()
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['likes', 'likeCount'])
        );
    }

    // COMMENTS
    match /comments/{commentId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update, delete: if isOwner();

      allow update, delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    // LIKES
    match /likes/{likeId} {
      allow read: if true;

      // On CREATE use request.resource.
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      // IMPORTANT: On DELETE request.resource does not exist.
      // Therefore DELETE must check resource.data.
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;

      allow update: if false;
    }

    // USERS
    match /users/{userId} {
      allow read: if isOwner()
        || (signedIn() && userId == request.auth.uid);

      allow create: if signedIn()
        && userId == request.auth.uid;

      allow update: if isOwner();

      allow update: if signedIn()
        && userId == request.auth.uid
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'name',
              'photoUrl',
              'displayName',
              'reporterStatus'
            ])
        && (
          !request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasAny(['reporterStatus'])
          || request.resource.data.reporterStatus == 'pending'
        );

      allow delete: if isOwner();
    }

    // REPORTER POSTS
    match /reporterPosts/{postId} {
      allow read: if isOwner()
        || (
          signedIn()
          && resource.data.reporterId == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'pending';

      allow update, delete: if isOwner();

      allow update, delete: if signedIn()
        && resource.data.reporterId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'pending';
    }

    // DEFAULT DENY
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
