rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // AUTH / ROLES
    // ============================================================
    function signedIn() {
      return request.auth != null;
    }

    // Owner is recognized by the profile role OR the existing owner UID.
    function isOwner() {
      return signedIn()
        && (
          (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner'
          )
          || request.auth.uid == 'awKV4C8EnfN2B15hCYAcTkGy7n1l'
        );
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwnerOrAdmin() {
      return isOwner() || isAdmin();
    }

    // ============================================================
    // NEWS
    // ============================================================
    match /news/{newsId} {
      allow read: if true;
      allow create, delete: if isOwnerOrAdmin();
      allow update: if isOwnerOrAdmin()
        || (
          signedIn()
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['likes', 'likeCount'])
        );
    }

    // ============================================================
    // LIKES
    // ============================================================
    match /news/{newsId}/likes/{userId} {
      allow read: if true;

      allow create: if signedIn()
        && userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;

      allow delete: if signedIn()
        && userId == request.auth.uid
        && resource.data.userId == request.auth.uid;

      allow update: if false;
    }

    // ============================================================
    // COMMENTS
    // ============================================================
    match /news/{newsId}/comments/{commentId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow delete: if isOwnerOrAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);

      allow update: if isOwnerOrAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    // ============================================================
    // USERS
    // ============================================================
    match /users/{userId} {
      allow read: if isOwnerOrAdmin()
        || (signedIn() && userId == request.auth.uid);

      allow create: if isOwnerOrAdmin()
        || (signedIn() && userId == request.auth.uid);

      // Owner can manage everything.
      // Admin can manage non-owner profiles and cannot create an owner role.
      // User can update only profile fields.
      allow update: if isOwner()
        || (
          isAdmin()
          && userId != 'awKV4C8EnfN2B15hCYAcTkGy7n1l'
          && request.resource.data.role != 'owner'
        )
        || (
          signedIn()
          && userId == request.auth.uid
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'name',
              'photoUrl',
              'displayName',
              'reporterStatus',
              'profileImage',
              'profilePhoto'
            ])
        );

      allow delete: if isOwner();
    }

    // ============================================================
    // REPORTER APPLICATIONS
    // Supports application documents using either userId or reporterId.
    // ============================================================
    match /reporterApplications/{applicationId} {
      allow read: if isOwnerOrAdmin()
        || (
          signedIn()
          && (
            resource.data.userId == request.auth.uid
            || resource.data.reporterId == request.auth.uid
          )
        );

      allow create: if signedIn()
        && (
          request.resource.data.userId == request.auth.uid
          || request.resource.data.reporterId == request.auth.uid
        );

      allow update: if isOwnerOrAdmin()
        || (
          signedIn()
          && (
            resource.data.userId == request.auth.uid
            || resource.data.reporterId == request.auth.uid
          )
        );

      allow delete: if isOwnerOrAdmin()
        || (
          signedIn()
          && (
            resource.data.userId == request.auth.uid
            || resource.data.reporterId == request.auth.uid
          )
        );
    }

    // ============================================================
    // REPORTER POSTS
    // ============================================================
    match /reporterPosts/{postId} {
      allow read: if isOwnerOrAdmin()
        || (
          signedIn()
          && resource.data.reporterId == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'pending';

      allow update: if isOwnerOrAdmin()
        || (
          signedIn()
          && resource.data.reporterId == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.reporterId == request.auth.uid
          && request.resource.data.status == 'pending'
        );

      allow delete: if isOwnerOrAdmin()
        || (
          signedIn()
          && resource.data.reporterId == request.auth.uid
          && resource.data.status == 'pending'
        );
    }

    // ============================================================
    // PENDING POSTS
    // ============================================================
    match /pendingPosts/{postId} {
      allow read: if isOwnerOrAdmin()
        || (
          signedIn()
          && resource.data.reporterId == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'pending';

      allow update: if isOwnerOrAdmin()
        || (
          signedIn()
          && resource.data.reporterId == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.reporterId == request.auth.uid
          && request.resource.data.status == 'pending'
        );

      allow delete: if isOwnerOrAdmin()
        || (
          signedIn()
          && resource.data.reporterId == request.auth.uid
          && resource.data.status == 'pending'
        );
    }

    // ============================================================
    // DEFAULT DENY
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
