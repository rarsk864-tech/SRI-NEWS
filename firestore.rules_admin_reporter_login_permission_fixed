rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // AUTH
    // ============================================================
    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && request.auth.uid == 'awKV4C8EnfN2B15hCYAcTkGy7nl1';
    }

    // ADMIN: role is stored in /users/{uid}.role
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'administrator'
        );
    }

    // REPORTER: accept role, roleLabel, or approved application status.
    function isReporter() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'reporter'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roleLabel == 'REPORTER'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.reporterStatus == 'approved'
        );
    }

    function isOwnerOrAdmin() {
      return isOwner() || isAdmin();
    }

    // ============================================================
    // NEWS
    // ============================================================
    match /news/{newsId} {
      allow read: if true;
      allow create, delete: if isOwnerOrAdmin();

      allow update: if isOwnerOrAdmin()
        || (
          signedIn()
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'likes',
                'likeCount'
              ])
        );

      match /likes/{userId} {
        allow read: if true;

        allow create: if signedIn()
          && userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid;

        allow delete: if signedIn()
          && userId == request.auth.uid
          && resource.data.userId == request.auth.uid;

        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if true;

        allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid;

        allow update, delete: if isOwner();

        allow update, delete: if signedIn()
          && resource.data.userId == request.auth.uid;
      }
    }

    // ============================================================
    // USERS
    // ============================================================
    match /users/{userId} {

      // Existing self-profile access stays unchanged.
      // Added ONLY email-self read so LoginPage can look up the
      // authenticated account by email without permission-denied.
      allow read: if isOwner()
        || (
          signedIn()
          && userId == request.auth.uid
        )
        || (
          signedIn()
          && resource.data.email == request.auth.token.email
        );

      // User creates own profile as a normal USER.
      allow create: if signedIn()
        && userId == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'user';

      // Owner can update anything.
      allow update: if isOwner();

      // Normal USER can submit/update only their own pending
      // Reporter/Admin application or safe profile fields.
      allow update: if signedIn()
        && userId == request.auth.uid
        && resource.data.role == 'user'
        && request.resource.data.role == 'user'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'uid',
              'name',
              'email',
              'photoUrl',
              'displayName',
              'role',
              'roleLabel',
              'reporterStatus',
              'reporterAppliedAt',
              'adminStatus',
              'adminAppliedAt',
              'updatedAt'
            ])
        && (
          !request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasAny(['reporterStatus'])
          || request.resource.data.reporterStatus == 'pending'
        )
        && (
          !request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasAny(['adminStatus'])
          || request.resource.data.adminStatus == 'pending'
        );

      allow delete: if isOwner();
    }

    // ============================================================
    // REPORTER POSTS
    // ============================================================
    match /reporterPosts/{postId} {
      allow read: if isOwnerOrAdmin()
        || (
          signedIn()
          && resource.data.reporterId == request.auth.uid
        );

      allow create: if isReporter()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'pending';

      allow update, delete: if isOwnerOrAdmin();

      allow update, delete: if signedIn()
        && resource.data.reporterId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'pending';
    }

    // ============================================================
    // DEFAULT DENY
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
